{
  "name": "tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm content:emit && next dev --hostname 0.0.0.0",
    "build": "pnpm content:check && NODE_ENV=production pnpm content:emit && next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:check": "tsx scripts/content-check.ts",
    "content:lock": "tsx scripts/content-lock.ts",
    "content:emit": "tsx scripts/content-emit.ts",
    "content:hash": "tsx scripts/content-hash.ts",
    "content:diff": "tsx scripts/content-diff.ts",
    "visual:shot": "tsx scripts/visual-shot.ts",
    "shots:sheet": "tsx scripts/shots-sheet.ts",
    "lesson:walk": "tsx scripts/lesson-walk.ts",
    "sources:import": "tsx scripts/sources-import.ts",
    "video:build": "tsx video/build.ts",
    "video:check": "tsx video/check.ts",
    "narration:build": "tsx video/narration-build.ts",
    "sounds:build": "tsx scripts/sounds-build.ts",
    "clean": "tsx scripts/clean.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.6",
    "next": "16.3.7",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "ts-fsrs": "^5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5",
    "fake-indexeddb": "^6.2.5",
    "gsap": "^3.15.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5"
  },
  "packageManager": "pnpm@9.13.2"
}
