        {
          "text": "Chào bạn! Hôm nay ta tìm số hạng chưa biết.",
          "opening": true
        },
        {
          "text": "Lan có một số tiền, ta chưa biết là bao nhiêu."
        },
        {
          "text": "Mẹ cho thêm 35 nghìn đồng."
        },
        {
          "text": "Bây giờ Lan có 82 nghìn đồng."
        },
        {
          "text": "Lúc đầu Lan có bao nhiêu?"
        }
      ]
    },
    {
      "id": "s02-viet",
      "sentences": [
        {
          "text": "Ta viết phép cộng: số chưa biết cộng 35 bằng 82."
        },
        {
          "text": "Số chưa biết là một số hạng."
        },
        {
          "text": "35 là số hạng đã biết, còn 82 là tổng."
        }
      ]
    },
    {
      "id": "s03-quy-tac",
      "sentences": [
        {
          "text": "Muốn tìm số hạng chưa biết, lấy tổng trừ đi số hạng đã biết.",
