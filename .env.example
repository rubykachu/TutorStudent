# Set to 1 to serve the fixture lesson (content/_fixture). Playwright sets it automatically.
CONTENT_INCLUDE_FIXTURE=

# Base URL of the media store (lesson videos). Unset: files under public/media,
# served by the app itself. At go-live: the media bucket's public URL.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Family-code gate (src/proxy.ts). Unset in local dev and tests: no gate. A
# production server needs both, or it serves nothing.
# Comma-separated entries written `<familyId>:<code>` (`nha-minh:abcd-efgh-jkmn`):
# the family id is 3 to 32 lowercase letters, digits or dashes and never changes
# once the family has synced progress; the code is at least 10 letters or digits
# (spaces, dashes and capitals are ignored when typed). A family may have
# several entries; one code under two family ids closes the gate. A bare code
# still opens the gate but its devices have no progress sync. Remove an entry
# to cut that code off; the runbook in docs/operations.md shows how to generate
# one.
FAMILY_CODES=
# Signs the cookie, at least 32 random characters. Changing it locks every
# device out until its code is entered again.
SESSION_SECRET=

# Progress sync storage: the private Cloudflare R2 bucket (src/sync/store/r2.ts).
# All four set: sync is on (a family entry needs a name in FAMILY_CODES too).
# None set: sync stays off and the app works as before. Never set VERCEL_ENV in
# a local file: only a Vercel production deployment writes under `prod/`. Setup
# and rotation: docs/operations.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
