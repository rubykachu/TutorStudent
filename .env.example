# Set to 1 to serve the fixture lesson (content/_fixture). Playwright sets it automatically.
CONTENT_INCLUDE_FIXTURE=

# Base URL of the media store (lesson videos). Unset: files under public/media,
# served by the app itself. At go-live: the media bucket's public URL.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Family-code gate (src/proxy.ts). Unset in local dev and tests: no gate. A
# production server needs both secrets, or it serves nothing.
# Signs every family code, at least 32 random characters, different from
# SESSION_SECRET. A code is `OWL` + family part + signature (`OWL4K7MQ-9QX2P8RT`;
# dashes, spaces and case are ignored when typed) and is checked by signing its
# family id again, so no list of codes exists. `pnpm family:code` prints new
# codes from this value. Changing it changes every family's code (family ids
# and progress stay); runbook in docs/operations.md, "Mã gia đình".
FAMILY_CODE_SECRET=
# Family ids (`OWL4K7MQ`), comma-separated, whose codes and cookies no longer
# open the app. Empty: none revoked. An entry that is not a family id closes
# the gate.
FAMILY_CODES_REVOKED=
# Signs the cookie, at least 32 random characters. Changing it locks every
# device out until its code is entered again; the codes stay the same.
SESSION_SECRET=

# Progress sync storage: the private Cloudflare R2 bucket (src/sync/store/r2.ts).
# All four set: sync is on; each family syncs under its family id.
# None set: sync stays off and the app works as before. Never set VERCEL_ENV in
# a local file: only a Vercel production deployment writes under `prod/`. Setup
# and rotation: docs/operations.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=

# Set to 1 at build time to turn offline support (the service worker) on.
# Unset, the app registers no worker and removes any it finds. Runbook:
# docs/operations.md, "Bật offline".
NEXT_PUBLIC_OFFLINE_ENABLED=

# Set to 1 at build time to retire the service worker on every device: the
# build writes a worker that deletes the offline caches and unregisters, and
# the app stops registering one. Unset is normal. Runbook: docs/operations.md,
# "Gỡ service worker lỗi".
NEXT_PUBLIC_OFFLINE_KILL_SWITCH=
