# dependencies
node_modules/
.pnp
.pnp.*

# next.js build output
.next/
.next-gate/
.next-sync/
out/
build/
next-env.d.ts
*.tsbuildinfo

# env files (only the documented template is committed)
.env*
!.env.example

# textbook sources are never committed
sources/

# test and screenshot output
coverage/
playwright-report/
test-results/
.shots/

# local progress-sync store (SYNC_STORE=fs:.sync-store)
.sync-store/

# deployment
.vercel/

# heavy video pipeline artifacts; rendered media is served from public/media
# locally and uploaded to the media bucket, never committed
video/projects/**/renders/
video/projects/**/audio/
video/.cache/
public/media/

# agent git worktrees: separate checkouts, never part of this tree
.claude/worktrees/

# misc
.DS_Store
*.pem
npm-debug.log*
.pnpm-debug.log*

# content emitted at build time from content/
public/content/
